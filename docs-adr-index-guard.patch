diff --git a/.github/workflows/adr-index.yml b/.github/workflows/adr-index.yml
index 48bd89f..17fd19c 100644
--- a/.github/workflows/adr-index.yml
+++ b/.github/workflows/adr-index.yml
@@ -28,8 +28,13 @@ jobs:
 
       - id: tree
         run: |
-          echo "current=$(git -C docs rev-parse HEAD:adr)" >> "$GITHUB_OUTPUT"
-          echo "indexed=$(jq -r '.adrTree // empty' docs/index/adrs.json 2>/dev/null)" >> "$GITHUB_OUTPUT"
+          set -euo pipefail
+          current=$(git -C docs rev-parse HEAD:adr)
+          test -n "$current" || { echo '::error::Empty adr/ tree hash: the index would be skipped as up to date'; exit 1; }
+          indexed=$(jq -r '.adrTree // empty' docs/index/adrs.json 2>/dev/null || true)
+          echo "current=$current" >> "$GITHUB_OUTPUT"
+          echo "indexed=$indexed" >> "$GITHUB_OUTPUT"
+          echo "Current adr/ tree $current; indexed ${indexed:-<none>}" >> "$GITHUB_STEP_SUMMARY"
 
       - if: steps.tree.outputs.current != steps.tree.outputs.indexed
         uses: actions/checkout@v4
@@ -62,7 +67,7 @@ jobs:
         env:
           ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
           TRACE_DIR: ${{ runner.temp }}/traces
-        run: npm start --silent -- --agent adr-index 'Index all ADRs' > "$RUNNER_TEMP/adrs.json"
+        run: node src/cli.ts --agent adr-index 'Index all ADRs' > "$RUNNER_TEMP/adrs.json"
 
       - if: always() && steps.tree.outputs.current != steps.tree.outputs.indexed
         uses: actions/upload-artifact@v4
@@ -75,6 +80,16 @@ jobs:
         env:
           ADR_TREE: ${{ steps.tree.outputs.current }}
         run: |
+          set -euo pipefail
+          expected=$(ls docs/adr/*.md | wc -l)
+          jq -e --argjson expected "$expected" '
+            (.adrs | length) == $expected
+            and ([.adrs[].id] | (length == (unique | length)))
+            and all(.adrs[]; (.id | test("^ADR-[0-9]{3}$")) and (.path | test("^adr/[0-9]{3}-[a-z0-9-]+\\.md$")))
+          ' "$RUNNER_TEMP/adrs.json" > /dev/null || { echo "::error::Generated index does not match adr/: expected $expected records with unique ids and valid paths"; exit 1; }
+          for path in $(jq -r '.adrs[].path' "$RUNNER_TEMP/adrs.json"); do
+            test -f "docs/$path" || { echo "::error::Generated index references a missing document: $path"; exit 1; }
+          done
           mkdir -p docs/index
           jq --arg adrTree "$ADR_TREE" \
              --arg generatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
@@ -94,5 +109,6 @@ jobs:
     steps:
       - uses: actions/checkout@v4
       - run: |
+          set -euo pipefail
           test -f index/adrs.json || { echo '::error::Missing ADR index: it is generated only on pull requests touching adr/'; exit 1; }
           test "$(git rev-parse HEAD:adr)" = "$(jq -r .adrTree index/adrs.json)" || { echo '::error file=index/adrs.json::Stale ADR index: adr/ changed without a pull request; open one touching adr/ to regenerate it'; exit 1; }
diff --git a/README.md b/README.md
index e190630..b9449ff 100644
--- a/README.md
+++ b/README.md
@@ -44,6 +44,7 @@ Format: context, decision, consequences. One page maximum.
 
 - A pull request touching `adr/` regenerates it and pushes the result to the same branch; review it with the ADR
 - It records the tree hash of `adr/` it came from; pushes to `main` fail when that hash is stale
+- Before committing, the index is checked against `adr/`: one record per document, unique ids, and every `path` present on disk
 - The run's trace is attached to the workflow as the `trace` artifact
 - Requires the repository secret `ANTHROPIC_API_KEY`, from an Anthropic workspace with a spend limit
 
